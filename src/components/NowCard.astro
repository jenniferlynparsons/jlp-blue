---
import Stamp from './Stamp.astro';
import { formatDate } from '../lib/dates';
import { getNowVersions } from '../lib/queries';

const current = (await getNowVersions())[0];
const d = current?.entry.data;
const groups = current ? [
  { label: 'Reading', items: d!.reading.slice(0, 3).map((r) => ({ em: r.title, rest: r.author ? ` — ${r.author}` : '', digging: r.digging })) },
  { label: 'Watching', items: d!.watching.slice(0, 2).map((w) => ({ em: w.title, rest: '', digging: w.digging })) },
  { label: 'Making', items: current.making.map((t) => ({ text: t })) },
  { label: 'Into lately', items: current.into.map((t) => ({ text: t })) },
].filter((g) => g.items.length > 0) : [];
---
{current && d && (
  <section class="card">
    <div class="top">
      <h2>Now</h2>
      <span>updated {formatDate(d.date)}</span>
      {d.draft && <Stamp label="DRAFT" variant="dashed" small tilt={0} />}
    </div>
    {d.quote?.text && (
      <blockquote>
        {d.quote.text}
        {d.quote.author && <span class="attr">— {d.quote.author} · from my commonplace book</span>}
      </blockquote>
    )}
    {groups.map((g) => (
      <div class="group">
        <h3>{g.label}</h3>
        {g.items.map((i) => (
          <span class="item">
            {'em' in i ? <><em>{i.em}</em>{i.rest}</> : i.text}
            {'digging' in i && i.digging && <> <Stamp label="DIGGING IT" small tilt={-3} /></>}
          </span>
        ))}
      </div>
    ))}
    <a class="more" href="/now/">full Now page · past versions →</a>
  </section>
)}

<style>
  .card { gap: 16px; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; font-family: var(--mono); }
  h2 { font-size: 18px; font-weight: 600; }
  .top span { font-size: 12px; color: var(--muted); }
  blockquote { padding-left: 14px; border-left: 2px solid var(--ink); font-size: 18px; line-height: 1.4; font-style: italic; }
  .attr { display: block; font-family: var(--mono); font-size: 11px; font-style: normal; color: var(--muted); padding-top: 6px; }
  .group { display: flex; flex-direction: column; gap: 6px; }
  h3 { font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .item { font-size: 17px; line-height: 1.4; }
</style>

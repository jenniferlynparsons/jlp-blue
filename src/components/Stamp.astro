---
import { STAMPS, type StampVariant } from '../lib/labels';

interface Props {
  /** A key from STAMPS (log type, status, kind), or pass `label` + `variant`. */
  value?: string;
  label?: string;
  variant?: StampVariant;
  small?: boolean;
  tilt?: number;
}

const s = Astro.props.value ? STAMPS[Astro.props.value] : undefined;
const label = Astro.props.label ?? s?.label ?? Astro.props.value;
const variant = Astro.props.variant ?? s?.variant ?? 'outline';
const { small = false, tilt = -2 } = Astro.props;
---
<span class:list={['stamp', variant, { small }]} style={`--tilt: ${tilt}deg`}>{label}</span>

<style>
  .stamp {
    display: inline-block; font-family: var(--mono); font-size: 12px; font-weight: 600; line-height: 1.3;
    letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
    border: 1.5px solid var(--ink); background: var(--card); color: var(--ink);
    padding: 3px 8px; transform: rotate(var(--tilt));
  }
  .small { font-size: 10px; }
  .filled { background: var(--ink); color: #fff; }
  .dashed { border-style: dashed; }
  .round { border-radius: 999px; }
  .muted { border-style: dashed; border-color: var(--muted); color: var(--muted); }
</style>
